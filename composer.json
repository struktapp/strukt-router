{
    "name": "strukt/router",
    "description": "Typed HTTP router with parameter matching, a middleware pipeline, reflection action resolution, and form validation.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "strukt/base": "v1.1.0",
        "strukt/commons": "v1.2.0",
        "strukt/contract": "v1.2.0",
        "strukt/form": "v1.0.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "strukt/cache": "v1.0.0"
    },
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strukt\\Router\\Fixtures\\": "tests/Fixtures/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "find src bin tests examples -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "bin": [
        "bin/routes"
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ],
    "version": "1.2.0"
}
